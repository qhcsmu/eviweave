* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
# Preserve frozen originals byte-for-byte, including their original line endings.
adaptive_evidence/*.py -text
preflight.py -text
eviweave/experimental/corpus_index.py -text
eviweave/experimental/content_tokens.py -text
eviweave/experimental/token_scorer.py -text
eviweave/experimental/lora_adapter.py -text
tests/upstream/*.py -text

# Preserve exact deployed-source bytes and the frozen deployment manifest.
candidate-v03/source/** -text
candidate-v03/DEPLOYED_MANIFEST.json -text

# Preserve archived Linux runtime and approved query-repair bytes.
candidate-v03/runtime-linux/source/** -text
candidate-v03/runtime-linux/*.service -text
# The approved encoder archive contains CRLF; retain its frozen hash.
candidate-v03/runtime-linux/source/remote_encoder.py whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
candidate-v03/runtime-linux/requirements.freeze.txt text eol=lf
.gitattributes text eol=lf
candidate-v03/artifacts/** -text
candidate-v03/training/RECIPE.json -text whitespace=cr-at-eol
candidate-v03/training/ISOLATION_AUDIT.json -text whitespace=cr-at-eol
candidate-v03/training/TRAINING_RESULT.json -text whitespace=cr-at-eol
candidate-v03/licenses/** -text whitespace=cr-at-eol

# Preserve original Python bytes after development relocation.
dependencies/exact32/adaptive_evidence/*.py -text
retrieval/eviweave/experimental/corpus_index.py -text
retrieval/eviweave/experimental/content_tokens.py -text
retrieval/eviweave/experimental/token_scorer.py -text
retrieval/eviweave/experimental/lora_adapter.py -text
benchmarks/tests/upstream/*.py -text

# Keep development metadata hashes stable across Windows and Linux clones.
.gitignore text eol=lf
LICENSE text eol=lf
